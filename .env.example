# Leave these empty to keep the app in zero-key mock mode.
EXPO_PUBLIC_CONVEX_URL=
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Set by `npx convex dev` after creating a project.
CONVEX_DEPLOYMENT=

# Backend environment variable: also set this in the Convex dashboard.
# Use your Clerk app's issuer URL, not its publishable key.
CLERK_JWT_ISSUER_DOMAIN=
